{
  "name": "reynard-reliability-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/agent-reliability-lab"
  ],
  "scripts": {
    "build": "pnpm --filter @waldzellai/agent-reliability-lab run build",
    "test:unit": "vitest run packages/agent-reliability-lab/tests/unit",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:integration": "vitest run packages/agent-reliability-lab/tests/integration",
    "test:acceptance": "vitest run packages/agent-reliability-lab/tests/integration/acceptance.integration.test.ts",
    "typecheck": "pnpm --filter @waldzellai/agent-reliability-lab run typecheck",
    "lint": "eslint eslint.config.js vitest.config.ts \"scripts/*.mjs\" \"packages/agent-reliability-lab/**/*.ts\"",
    "verify": "pnpm run build && pnpm run typecheck && pnpm run lint && pnpm run guard:production-source && pnpm run test:unit && pnpm run test:integration && pnpm run guard:retirement",
    "lab": "node packages/agent-reliability-lab/dist/cli.js",
    "guard:production-source": "node scripts/guard-production-source.mjs",
    "guard:retirement": "node scripts/guard-retirement.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.5.0",
    "@types/node": "^20.11.30",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.5.0",
    "typescript": "^5.5.4",
    "vitest": "1.2.2"
  }
}
